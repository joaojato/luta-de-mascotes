# Copie para .env e preencha. O .env fica fora do git.
# Chave criada em https://app.spriterrific.com (menu API keys).
SPRITERRIFIC_API_KEY=

# Controle por celular pela internet (ADR 0005). Sem estas duas, o celular usa
# o relay do Vite. Valores em Supabase > Project Settings > API. Na Vercel,
# as mesmas duas vão em Settings > Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
